+
+  async executeManualBypassTransaction(
+    input: BypassManualPegawaiInput,
+  ): Promise<BypassManualResultDto> {
+    const { pegawai_id, tanggal_awal, tanggal_akhir, alasan } = input;
+    const isAutoShift = !input.shift || input.shift === 'AUTO';
+
+    let startDate = dayjs(tanggal_awal);
+    const endDate = dayjs(tanggal_akhir);
+
+    if (!startDate.isValid() || !endDate.isValid() || startDate.isAfter(endDate)) {
+      throw new Error('Format tanggal tidak valid atau tanggal awal melebihi tanggal akhir.');
+    }
+
+    const processedDates: string[] = [];
+
+    await this.dataSource.transaction(async (manager: EntityManager) => {
+      let current = startDate;
+
+      while (current.isBefore(endDate) || current.isSame(endDate, 'day')) {
+        const dateStr = current.format('YYYY-MM-DD');
+        const d = current.date();
+        const m = current.month() + 1;
+        const y = current.year();
+
+        let shift = 'Pagi'; // Fallback
+        
+        if (!isAutoShift && input.shift) {
+          shift = input.shift;
+        } else {
+          // Cari dari jadwal_tambahan
+          const jtQ = `SELECT h${d} as shift FROM jadwal_tambahan WHERE id = ? AND bulan = ? AND tahun = ?`;
+          const jtRes = await manager.query(jtQ, [pegawai_id, m, y]);
+          
+          let shiftFound = null;
+          if (jtRes.length > 0 && jtRes[0].shift && jtRes[0].shift.trim() !== '') {
+            shiftFound = jtRes[0].shift.trim();
+          } else {
+            // Cari dari jadwal_pegawai
+            const jpQ = `SELECT h${d} as shift FROM jadwal_pegawai WHERE id = ? AND bulan = ? AND tahun = ?`;
+            const jpRes = await manager.query(jpQ, [pegawai_id, m, y]);
+            if (jpRes.length > 0 && jpRes[0].shift && jpRes[0].shift.trim() !== '') {
+              shiftFound = jpRes[0].shift.trim();
+            }
+          }
+
+          if (shiftFound && !['OFF', 'Libur', 'LIBUR', '-', 'Cuti'].includes(shiftFound)) {
+            shift = shiftFound;
+          }
+        }
+
+        const refCutiNo = alasan ? `Bypass-${alasan.substring(0,20).replace(/\\s+/g, '')}` : 'Bypass';
+        const catatanSupervisor = `Manual bypass: ${alasan || 'Dispensasi'}`;
+
+        const phQ = `SELECT id FROM penilaian_harian WHERE pegawai_id = ? AND DATE(tanggal) = DATE(?)`;
+        const phRes = await manager.query(phQ, [pegawai_id, dateStr]);
+
+        let phId = null;
+
+        if (phRes.length > 0) {
+          phId = phRes[0].id;
+          const upQ = `
+            UPDATE penilaian_harian 
+            SET shift_jadwal = ?, sumber_absensi = 'manual_bypass', ref_cuti_no = ?, nilai_kondisi = 'Bypass Khusus', 
+                skor_kegiatan = 100, skor_absensi = 100, skor_total = 100, status = 'approved', catatan_supervisor = ? 
+            WHERE id = ?
+          `;
+          await manager.query(upQ, [shift, refCutiNo, catatanSupervisor, phId]);
+        } else {
+          const insQ = `
+            INSERT INTO penilaian_harian 
+            (pegawai_id, tanggal, shift_jadwal, sumber_absensi, ref_cuti_no, nilai_kondisi, skor_kegiatan, skor_absensi, skor_total, status, catatan_supervisor) 
+            VALUES (?, ?, ?, 'manual_bypass', ?, 'Bypass Khusus', 100, 100, 100, 'approved', ?)
+          `;
+          const insRes = await manager.query(insQ, [pegawai_id, dateStr, shift, refCutiNo, catatanSupervisor]);
+          phId = insRes.insertId;
+        }
+
+        const khQ = `SELECT id FROM kegiatan_harian WHERE penilaian_id = ?`;
+        const khRes = await manager.query(khQ, [phId]);
+
+        if (khRes.length === 0) {
+          const khInsQ = `
+            INSERT INTO kegiatan_harian (penilaian_id, judul_kegiatan, penjabaran, status_selesai, urutan) 
+            VALUES (?, ?, ?, 1, 1)
+          `;
+          const judul = `Bypass Nilai Khusus (${alasan || 'Dispensasi'})`;
+          await manager.query(khInsQ, [phId, judul, judul]);
+        }
+
+        processedDates.push(dateStr);
+        current = current.add(1, 'day');
+      }
+    });
+
+    return {
+      success: true,
+      message: `Manual bypass berhasil untuk ${processedDates.length} hari`,
+      processedCount: processedDates.length,
+      processedDates
+    };
+  }
 }
+

