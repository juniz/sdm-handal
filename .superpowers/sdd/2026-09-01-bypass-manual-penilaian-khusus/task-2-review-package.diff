       });
 
       await service.processBypass(1, 'SDM', {} as any);
 
       expect(repository.executeBypassTransaction).toHaveBeenCalledWith([]);
     });
   });
+
+  describe('processManualBypass', () => {
+    it('should throw ForbiddenException if user is not authorized', async () => {
+      (repository.isAuthorized as jest.Mock).mockResolvedValue(false);
+
+      const input = {
+        pegawai_id: 123,
+        tanggal_awal: '2026-09-01',
+        tanggal_akhir: '2026-09-03',
+        shift: 'Pagi',
+        alasan: 'Dispensasi pelatihan',
+      };
+
+      await expect(
+        service.processManualBypass(1, 'MEDIS', input),
+      ).rejects.toThrow(ForbiddenException);
+
+      expect(repository.isAuthorized).toHaveBeenCalledWith(1, 'MEDIS');
+      expect(repository.executeManualBypassTransaction).not.toHaveBeenCalled();
+    });
+
+    it('should execute manual bypass transaction when user is authorized', async () => {
+      const mockResult = {
+        success: true,
+        message: 'Manual bypass berhasil untuk 3 hari',
+        processedCount: 3,
+        processedDates: ['2026-09-01', '2026-09-02', '2026-09-03'],
+      };
+
+      (repository.isAuthorized as jest.Mock).mockResolvedValue(true);
+      (repository.executeManualBypassTransaction as jest.Mock).mockResolvedValue(mockResult);
+
+      const input = {
+        pegawai_id: 123,
+        tanggal_awal: '2026-09-01',
+        tanggal_akhir: '2026-09-03',
+        shift: 'Pagi',
+        alasan: 'Dispensasi pelatihan',
+      };
+
+      const result = await service.processManualBypass(1, 'SDM', input);
+
+      expect(repository.isAuthorized).toHaveBeenCalledWith(1, 'SDM');
+      expect(repository.executeManualBypassTransaction).toHaveBeenCalledWith(input);
+      expect(result).toEqual(mockResult);
+    });
+  });
 });
